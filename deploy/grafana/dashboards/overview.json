{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Global Message Flow & Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Inbound Message Throughput (msgs/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(conversation_messages_received_total[1m])) by (channel)",
          "legendFormat": "{{channel}} received"
        },
        {
          "expr": "sum(rate(conversation_messages_rejected_total[1m])) by (reason)",
          "legendFormat": "rejected: {{reason}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "End-to-End Latency (Ingest & Delivery p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(conversation_ingest_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Ingest Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(conversation_execution_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 AI Runtime Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(outbound_delivery_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Outbound Delivery Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "title": "AI Execution & Multi-Tenant Volume",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "AI Execution Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(conversation_executions_total{status=\"succeeded\"}[5m])) / sum(rate(conversation_executions_total[5m])) * 100",
          "legendFormat": "Success Rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 9 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Message Volume by Tenant",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(conversation_messages_received_total[5m])) by (tenant_id)",
          "legendFormat": "tenant: {{tenant_id}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["conversation-engine", "overview", "executive"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Conversation Engine - Executive & Overview",
  "uid": "ce-overview",
  "version": 1
}
