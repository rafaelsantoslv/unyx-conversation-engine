{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Outbound Intents & Dispatch Rate",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "title": "Outbound Delivery Throughput by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(outbound_intents_total[1m])) by (status)",
          "legendFormat": "status: {{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "title": "Delivery Latency to Chatwoot (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(outbound_delivery_duration_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "{{channel}} p95 latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 4,
      "title": "External Error Rates & Delivery Reconciliation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "Chatwoot Rate Limits & Failures (HTTP 429/5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(outbound_intents_total{status=~\"rate_limited|failed\"}[1m])) by (status)",
          "legendFormat": "failures: {{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "Ambiguous Deliveries Reconciled (Two Generals' Problem)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(outbound_intents_total{status=~\"reconciled_delivered|reconciled_rescheduled\"}[1m])) by (status)",
          "legendFormat": "reconciled: {{status}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["conversation-engine", "outbound", "chatwoot", "delivery"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Conversation Engine - Outbound Delivery",
  "uid": "ce-outbound",
  "version": 1
}
